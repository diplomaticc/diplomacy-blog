---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/SiteLayout.astro';
import HeroShell from '../components/HeroShell';
import LaunchCountdown from '../components/LaunchCountdown';
import ActiveAgenda from '../components/ActiveAgenda';
import StatsSection from '../components/StatsSection';
import DepartureSection from '../components/DepartureSection';
import DiscoverySection from '../components/DiscoverySection';
import MissionsSection from '../components/MissionsSection';

// Fetch the core datasets from your repository content folders
const homepage = await getEntry('homepage', 'index');
const departures = await getCollection('departures');
const missions = await getCollection('missions');

const leftNav = [
  { label: "Agenda", href: "#agenda" },
  { label: "Engagements", href: "/engagements" },
  { label: "Research", href: "/research" }
];

const rightNav = [
  { label: "Technology", href: "/technology" },
  { label: "News", href: "/news" },
  { label: "About", href: "/about" }
];

const mobileNav = [...leftNav, ...rightNav];

// Define a unified data layout configuration with safe object fallbacks
const homepageData = homepage?.data || {};
---

<Layout title="DIPLOMATICC | Geopolitical Intelligence & Strategic Analysis">
  <main class="bg-[#060a12] min-h-screen selection:bg-blue-500/30 selection:text-blue-200">
    
    {/* 1. Hero Banner Section with multi-compatible data properties */}
    <HeroShell 
      client:load 
      {...homepageData}
      content={homepageData.hero || homepageData || {}}
      leftNav={leftNav} 
      rightNav={rightNav} 
      mobileNav={mobileNav} 
    />

    {/* 2. Original Interactive Countdown Segment */}
    <LaunchCountdown 
      client:visible 
      {...homepageData} 
      content={homepageData.launchCountdown || homepageData} 
    />

    {/* 3. Your Upgraded Strategic Matrix Section (From Screenshot 2026-05-31 233950.png) */}
    <div id="agenda" class="scroll-mt-20">
      <ActiveAgenda client:visible />
    </div>
    
    {/* 4. Original Statistical Data Graph Display */}
    <StatsSection 
      client:visible 
      {...homepageData} 
      stats={homepageData.stats || []} 
      content={homepageData.stats || homepageData} 
    />

    {/* 5. Original Template Deep-Content Navigation Sections */}
    <DepartureSection 
      client:visible 
      {...homepageData} 
      departures={departures} 
      content={homepageData.departures || homepageData} 
    />
    
    <DiscoverySection 
      client:visible 
      {...homepageData} 
      content={homepageData.discovery || homepageData} 
    />
    
    <MissionsSection 
      client:visible 
      {...homepageData} 
      missions={missions} 
      content={homepageData.missions || homepageData} 
    />

  </main>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
