---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/SiteLayout.astro';
import HeroShell from '../components/HeroShell';
import LaunchCountdown from '../components/LaunchCountdown';
import ActiveAgenda from '../components/ActiveAgenda';
import StatsSection from '../components/StatsSection';
import DepartureSection from '../components/DepartureSection';
import DiscoverySection from '../components/DiscoverySection';
import MissionsSection from '../components/MissionsSection';

// 1. Fetch native template datasets from the content layer
const homepage = await getEntry('homepage', 'index');
const departures = await getCollection('departures');
const missions = await getCollection('missions');

// 2. Safely isolate data groups to prevent variable clashing
const hero = homepage?.data?.hero || {};
const launchCountdown = homepage?.data?.launchCountdown || {};
const stats = homepage?.data?.stats || [];
const departuresData = homepage?.data?.departures || {};
const discovery = homepage?.data?.discovery || {};
const missionsData = homepage?.data?.missions || {};

// 3. Navigation routing
const leftNav = [
  { label: "Agenda", href: "#agenda" },
  { label: "Engagements", href: "/engagements" },
  { label: "Research", href: "/research" }
];

const rightNav = [
  { label: "Technology", href: "/technology" },
  { label: "News", href: "/news" },
  { label: "About", href: "/about" }
];

const mobileNav = [...leftNav, ...rightNav];
---

<Layout title="DIPLOMATICC | Geopolitical Intelligence & Strategic Analysis">
  <main class="bg-[#060a12] min-h-screen selection:bg-blue-500/30 selection:text-blue-200">
    
    {/* 1. Hero Header - Supporting both direct props and object parameters */}
    <HeroShell 
      client:load 
      hero={hero}
      {...hero}
      leftNav={leftNav} 
      rightNav={rightNav} 
      mobileNav={mobileNav} 
    />

    {/* 2. Original Interactive Countdown Segment */}
    <LaunchCountdown 
      client:visible 
      launchCountdown={launchCountdown}
      {...launchCountdown} 
    />

    {/* 3. Your Upgraded Strategic Matrix Section (Kept exactly as shown in Screenshot 2026-05-31 233950.png) */}
    <div id="agenda" class="scroll-mt-20">
      <ActiveAgenda client:visible />
    </div>
    
    {/* 4. Original Statistical Data Graph Display */}
    <StatsSection 
      client:visible 
      stats={stats}
      {...stats} 
    />

    {/* 5. Original Template Deep-Content Navigation Panels */}
    <DepartureSection 
      client:visible 
      {...departuresData} 
      departures={departures} 
    />
    
    <DiscoverySection 
      client:visible 
      discovery={discovery}
      {...discovery} 
    />
    
    <MissionsSection 
      client:visible 
      {...missionsData} 
      missions={missions} 
    />

  </main>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
