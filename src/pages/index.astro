---
import Layout from '../layouts/SiteLayout.astro';
import HeroShell from '../components/HeroShell';
import LaunchCountdown from '../components/LaunchCountdown';
import ActiveAgenda from '../components/ActiveAgenda';
import StatsSection from '../components/StatsSection';
import DepartureSection from '../components/DepartureSection';
import DiscoverySection from '../components/DiscoverySection';
import MissionsSection from '../components/MissionsSection';

// Restored default navigation structures matching the template parameters
const leftNav = [
  { label: "Agenda", href: "#agenda" },
  { label: "Engagements", href: "/engagements" },
  { label: "Research", href: "/research" }
];

const rightNav = [
  { label: "Technology", href: "/technology" },
  { label: "News", href: "/news" },
  { label: "About", href: "/about" }
];

const mobileNav = [...leftNav, ...rightNav];
---

<Layout title="DIPLOMATICC | Geopolitical Intelligence & Strategic Analysis">
  <main class="bg-[#060a12] min-h-screen selection:bg-blue-500/30 selection:text-blue-200">
    
    {/* 1. Original Template Hero Top Banner Section */}
    <HeroShell 
      client:load 
      leftNav={leftNav} 
      rightNav={rightNav} 
      mobileNav={mobileNav} 
    />

    {/* 2. Original Interactive Countdown Segment */}
    <LaunchCountdown client:visible />

    {/* 3. Your Upgraded Strategic Matrix Block (From Screenshot 2026-05-31 233950.png) */}
    <div id="agenda" class="scroll-mt-20">
      <ActiveAgenda client:visible />
    </div>
    
    {/* 4. Original Statistical Data Graph Display */}
    <StatsSection client:visible />

    {/* 5. Original Template Deep-Content Navigation Sections */}
    <DepartureSection client:visible />
    <DiscoverySection client:visible />
    <MissionsSection client:visible />

  </main>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
