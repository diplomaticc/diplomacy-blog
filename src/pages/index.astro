---
import Layout from '../layouts/SiteLayout.astro';
import HeroShell from '../components/HeroShell';

const heroContent = {
  image: "/images/diplomatic-hero.jpg",
  utilityLabel: "Est. 2026 // Operational Matrix",
  paragraph: "Diplomaticc delivers rigorous cross-border analysis, tracking critical chokepoints, bilateral statecraft negotiations, and the structural systemic shifts within global security architectures.",
  primaryCta: { label: "Access Briefings", href: "#agenda" },
  secondaryCta: { label: "Research Repository", href: "/research" }
};

const leftNav = [
  { label: "Agenda", href: "#agenda" },
  { label: "Engagements", href: "/engagements" },
  { label: "Research", href: "/research" }
];

const rightNav = [
  { label: "Technology", href: "/technology" },
  { label: "News", href: "/news" },
  { label: "About", href: "/about" }
];

const mobileNav = [...leftNav, ...rightNav];
---

<Layout title="DIPLOMATICC | Geopolitical Intelligence & Strategic Analysis">
  <main class="bg-[#060a12] min-h-screen selection:bg-blue-500/30 selection:text-blue-200">
    
    <HeroShell 
      client:load 
      content={heroContent} 
      leftNav={leftNav} 
      rightNav={rightNav} 
      mobileNav={mobileNav} 
    />

  </main>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
