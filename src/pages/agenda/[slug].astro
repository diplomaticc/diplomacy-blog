---
import { render } from 'astro:content';

import EntryLayout from '../../layouts/EntryLayout.astro';
import { getMissionEntries } from '../../lib/content';

export async function getStaticPaths() {
  const missions = await getMissionEntries();
  return missions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  eyebrow="Active File"
  summary={entry.data.summary}
  image={entry.data.coverImage}
  backHref="/agenda/"
  backLabel="All files"
  details={[
    { label: 'Status', value: entry.data.status },
    { label: 'Region', value: entry.data.region },
    { label: 'Parties', value: entry.data.parties },
    { label: 'Timeline', value: entry.data.timeline },
  ]}
>
  <Content />
</EntryLayout>
